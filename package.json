{
	"name": "steam-sweep",
	"description": "🧹 A lightweight Windows Electron app for scanning Steam game libraries and safely removing unnecessary leftover files.",
	"author": "tuty",
	"private": true,
	"version": "1.0.7",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.app.json && vite build",
		"build:dir": "npm run build && electron-builder --win --dir",
		"build:portable": "npm run build && electron-builder --win portable",
		"build:installer": "rm -rf release && npm run build && electron-builder",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"stylelint": "stylelint \"src/**/*.css\"",
		"stylelint:fix": "stylelint \"src/**/*.css\" --fix",
		"spellcheck": "cspell .",
		"spellcheck:fix": "cspell . --words-only"
	},
	"build": {
		"appId": "com.steamsweep.app",
		"productName": "SteamSweep",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"dist-electron/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "build/icon.ico",
				"to": "icon.ico"
			}
		],
		"asar": true,
		"compression": "maximum",
		"npmRebuild": false,
		"win": {
			"target": "nsis",
			"icon": "build/icon.ico",
			"signExecutable": false,
			"artifactName": "${productName}.Setup.${version}.${ext}"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": false,
			"shortcutName": "SteamSweep"
		},
		"publish": {
			"provider": "github",
			"owner": "tutyamxx",
			"repo": "Steam-Sweep"
		}
	},
	"dependencies": {
		"electron-updater": "^6.8.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.13.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.0",
		"cspell": "^9.8.0",
		"electron": "latest",
		"electron-builder": "^26.15.3",
		"eslint": "^10.10.0",
		"eslint-plugin-jsdoc": "^63.3.3",
		"eslint-plugin-prefer-arrow-functions": "^3.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"globals": "^17.12.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.3.0",
		"vite-plugin-electron": "^1.1.2"
	}
}
